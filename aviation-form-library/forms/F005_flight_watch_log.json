{
  "formCode": "F005",
  "name": "Flight Watch Log",
  "version": "1.0",
  "category": "dispatch",
  "status": "ACTIVE",
  "sourceStatus": "IMPLEMENTATION_TEMPLATE_NOT_OFFICIAL",
  "description": "In-flight monitoring log for flight following. Records position reports, weather updates, fuel checks, and significant events.",
  "fields": [
    {
      "name": "flightNumber",
      "type": "string",
      "required": true
    },
    {
      "name": "airlineCode",
      "type": "string",
      "required": true
    },
    {
      "name": "departureAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "arrivalAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "aircraftRegistration",
      "type": "string",
      "required": true
    },
    {
      "name": "operationalDate",
      "type": "string",
      "format": "date",
      "required": true
    },
    {
      "name": "actualDeparture",
      "type": "string",
      "format": "date-time",
      "required": true
    },
    {
      "name": "watchEntries",
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "time": { "type": "string", "format": "date-time", "description": "UTC time of entry" },
          "type": { "type": "string", "enum": ["POSITION", "FUEL_CHECK", "WEATHER_UPDATE", "ATC_COMM", "SIGNIFICANT_EVENT", "CREW_REPORT", "DIVERSION", "EMERGENCY"] },
          "position": { "type": "object", "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" }, "fix": { "type": "string" }, "flightLevel": { "type": "string" } } },
          "fuelRemaining": { "type": "number", "description": "Fuel remaining in kg/lbs" },
          "nextPosition": { "type": "string" },
          "etaNext": { "type": "string", "format": "time" },
          "weather": { "type": "string" },
          "eventDescription": { "type": "string" },
          "actionTaken": { "type": "string" },
          "recordedBy": { "type": "string" }
        }
      }
    },
    {
      "name": "finalFuelOnArrival",
      "type": "number",
      "required": false,
      "description": "Fuel remaining at destination"
    },
    {
      "name": "diversionDetails",
      "type": "object",
      "required": false,
      "properties": {
        "diversionAirport": { "type": "string", "format": "icao_code" },
        "reason": { "type": "string" },
        "time": { "type": "string", "format": "date-time" },
        "fuelAtDiversion": { "type": "number" }
      }
    },
    {
      "name": "dispatcherOnWatch",
      "type": "string",
      "required": true
    },
    {
      "name": "watchHandover",
      "type": "array",
      "required": false,
      "items": {
        "type": "object",
        "properties": {
          "time": { "type": "string", "format": "date-time" },
          "fromDispatcher": { "type": "string" },
          "toDispatcher": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  ],
  "workflow": [
    "ACTIVE",
    "IN_PROGRESS",
    "DIVERTED",
    "COMPLETED",
    "ARCHIVED"
  ],
  "permissions": {
    "create": ["DISPATCHER"],
    "log_entry": ["DISPATCHER", "FLIGHT_WATCH"],
    "handover": ["DISPATCHER", "SENIOR_DISPATCHER"],
    "close": ["DISPATCHER", "SENIOR_DISPATCHER"],
    "view": ["FLIGHT_OPS", "MANAGEMENT", "CREW"]
  },
  "validationRules": [
    { "field": "watchEntries", "rule": "not_empty", "message": "At least one watch entry required" },
    { "field": "actualDeparture", "rule": "before_now", "message": "Departure time cannot be in the future" }
  ],
  "uiMetadata": {
    "layout": "flight_watch_log",
    "sections": [
      { "id": "header", "label": "Flight Identification", "fields": ["flightNumber", "airlineCode", "aircraftRegistration", "operationalDate", "actualDeparture", "dispatcherOnWatch"] },
      { "id": "entries", "label": "Watch Log Entries", "fields": ["watchEntries"] },
      { "id": "diversion", "label": "Diversion Details", "fields": ["diversionDetails"] },
      { "id": "handover", "label": "Watch Handovers", "fields": ["watchHandover"] },
      { "id": "summary", "label": "Arrival Summary", "fields": ["finalFuelOnArrival"] }
    ]
  },
  "pdfMetadata": {
    "template": "flight_watch_log",
    "pageSize": "A4",
    "orientation": "landscape",
    "multiPage": true
  },
  "auditRequired": true,
  "sourceReference": "ICAO Annex 6, Operator flight following procedures",
  "notes": "Continuous watch required for all flights. Log entries in real-time."
}