{
  "formCode": "F014",
  "name": "Passenger Irregularity",
  "version": "1.0",
  "category": "passenger",
  "status": "ACTIVE",
  "sourceStatus": "IMPLEMENTATION_TEMPLATE_NOT_OFFICIAL",
  "description": "Record of passenger irregularities including denied boarding, offloading, missed connections, baggage issues, and compensation.",
  "fields": [
    {
      "name": "flightNumber",
      "type": "string",
      "required": true
    },
    {
      "name": "airlineCode",
      "type": "string",
      "required": true
    },
    {
      "name": "departureAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "arrivalAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "operationalDate",
      "type": "string",
      "format": "date",
      "required": true
    },
    {
      "name": "irregularityNumber",
      "type": "string",
      "required": true,
      "description": "Unique irregularity reference"
    },
    {
      "name": "passengerId",
      "type": "string",
      "required": true
    },
    {
      "name": "givenName",
      "type": "string",
      "required": true
    },
    {
      "name": "familyName",
      "type": "string",
      "required": true
    },
    {
      "name": "irregularityType",
      "type": "string",
      "required": true,
      "enum": ["DENIED_BOARDING", "INVOLUNTARY_OFFLOAD", "VOLUNTARY_OFFLOAD", "MISSED_CONNECTION", "BAGGAGE_IRREGULARITY", "DOCUMENT_ISSUE", "MEDICAL", "BEHAVIORAL", "SECURITY", "VISA_ISSUE", "OVERBOOKING", "EQUIPMENT_CHANGE", "OTHER"]
    },
    {
      "name": "irregularityCategory",
      "type": "string",
      "required": true,
      "enum": ["OPERATIONAL", "PASSENGER", "TECHNICAL", "WEATHER", "ATC", "SECURITY", "COMMERCIAL"]
    },
    {
      "name": "description",
      "type": "string",
      "required": true
    },
    {
      "name": "timeOccurred",
      "type": "string",
      "format": "date-time",
      "required": true
    },
    {
      "name": "reportedBy",
      "type": "string",
      "required": true
    },
    {
      "name": "reportedAt",
      "type": "string",
      "format": "date-time",
      "required": true
    },
    {
      "name": "impact",
      "type": "object",
      "required": false,
      "properties": {
        "delayMinutes": { "type": "integer", "minimum": 0 },
        "rebookedFlight": { "type": "string" },
        "rebookedDate": { "type": "string", "format": "date" },
        "hotelProvided": { "type": "boolean", "default": false },
        "mealsProvided": { "type": "boolean", "default": false },
        "transportProvided": { "type": "boolean", "default": false },
        "compensationOffered": { "type": "number", "minimum": 0 },
        "compensationCurrency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "compensationAccepted": { "type": "boolean", "default": false }
      }
    },
    {
      "name": "baggageDetails",
      "type": "object",
      "required": false,
      "properties": {
        "tagNumbers": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["LOADED", "OFFLOADED", "TRANSFERRED", "LEFT_BEHIND", "DAMAGED", "PILFERED"] },
        "deliveryArranged": { "type": "boolean", "default": false },
        "deliveryAddress": { "type": "string" }
      }
    },
    {
      "name": "witnesses",
      "type": "array",
      "required": false,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "contact": { "type": "string" },
          "statement": { "type": "string" }
        }
      }
    },
    {
      "name": "resolution",
      "type": "string",
      "required": false,
      "enum": ["REBOOKED", "REFUNDED", "COMPENSATED", "DENIED", "ESCALATED", "PENDING"]
    },
    {
      "name": "resolutionDetails",
      "type": "string",
      "required": false
    },
    {
      "name": "resolvedBy",
      "type": "string",
      "required": false
    },
    {
      "name": "resolvedAt",
      "type": "string",
      "format": "date-time",
      "required": false
    },
    {
      "name": "regulatoryReportRequired",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "name": "regulatoryReference",
      "type": "string",
      "required": false
    }
  ],
  "workflow": [
    "REPORTED",
    "INVESTIGATING",
    "RESOLUTION_PENDING",
    "RESOLVED",
    "COMPENSATED",
    "CLOSED",
    "ARCHIVED"
  ],
  "permissions": {
    "create": ["CHECKIN_AGENT", "GATE_AGENT", "BAGGAGE_AGENT", "DUTY_MANAGER", "CUSTOMER_SERVICE"],
    "investigate": ["DUTY_MANAGER", "CUSTOMER_SERVICE", "COMPLIANCE"],
    "resolve": ["DUTY_MANAGER", "CUSTOMER_SERVICE_MANAGER", "COMPLIANCE"],
    "compensate": ["CUSTOMER_SERVICE_MANAGER", "FINANCE"],
    "view": ["PASSENGER", "CREW", "MANAGEMENT", "COMPLIANCE", "LEGAL"]
  },
  "validationRules": [
    { "field": "timeOccurred", "rule": "before_or_equal", "refField": "reportedAt", "message": "Occurrence time cannot be after report time" },
    { "field": "irregularityType", "rule": "denied_boarding_requires_compensation", "message": "Denied boarding requires compensation details" }
  ],
  "uiMetadata": {
    "layout": "passenger_irregularity",
    "sections": [
      { "id": "header", "label": "Flight & Passenger", "fields": ["flightNumber", "airlineCode", "departureAirport", "arrivalAirport", "operationalDate", "passengerId", "givenName", "familyName"] },
      { "id": "irregularity", "label": "Irregularity Details", "fields": ["irregularityNumber", "irregularityType", "irregularityCategory", "description", "timeOccurred", "reportedBy", "reportedAt"] },
      { "id": "impact", "label": "Impact & Assistance", "fields": ["impact"] },
      { "id": "baggage", "label": "Baggage Details", "fields": ["baggageDetails"] },
      { "id": "witnesses", "label": "Witnesses", "fields": ["witnesses"] },
      { "id": "resolution", "label": "Resolution", "fields": ["resolution", "resolutionDetails", "resolvedBy", "resolvedAt"] },
      { "id": "regulatory", "label": "Regulatory", "fields": ["regulatoryReportRequired", "regulatoryReference"] }
    ]
  },
  "pdfMetadata": {
    "template": "passenger_irregularity",
    "pageSize": "A4",
    "orientation": "portrait"
  },
  "auditRequired": true,
  "sourceReference": "EC 261/2004, US DOT 14 CFR 250, Montreal Convention, IATA Resolution 735",
  "notes": "Regulatory reporting timelines vary by jurisdiction. Compensation per applicable regulation."
}