{
  "formCode": "F020",
  "name": "Preliminary Loadsheet",
  "version": "1.0",
  "category": "loadcontrol",
  "status": "ACTIVE",
  "sourceStatus": "IMPLEMENTATION_TEMPLATE_NOT_OFFICIAL",
  "description": "Preliminary loadsheet for initial load planning. Used for fuel planning, performance calculations, and initial load instruction. Based on IATA AHM 515/516.",
  "fields": [
    {
      "name": "flightNumber",
      "type": "string",
      "required": true
    },
    {
      "name": "airlineCode",
      "type": "string",
      "required": true
    },
    {
      "name": "departureAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "arrivalAirport",
      "type": "string",
      "required": true,
      "format": "icao_code"
    },
    {
      "name": "aircraftRegistration",
      "type": "string",
      "required": true
    },
    {
      "name": "aircraftType",
      "type": "string",
      "required": true
    },
    {
      "name": "operationalDate",
      "type": "string",
      "format": "date",
      "required": true
    },
    {
      "name": "scheduledDeparture",
      "type": "string",
      "format": "date-time",
      "required": true
    },
    {
      "name": "dryOperatingWeight",
      "type": "number",
      "required": true,
      "description": "Dry operating weight (kg)"
    },
    {
      "name": "dryOperatingIndex",
      "type": "number",
      "required": true,
      "description": "Dry operating index"
    },
    {
      "name": "paxDistribution",
      "type": "object",
      "required": true,
      "properties": {
        "businessClass": { "type": "integer", "minimum": 0 },
        "economyClass": { "type": "integer", "minimum": 0 },
        "premiumEconomy": { "type": "integer", "minimum": 0 },
        "firstClass": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "male": { "type": "integer", "minimum": 0 },
        "female": { "type": "integer", "minimum": 0 },
        "children": { "type": "integer", "minimum": 0 },
        "infants": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "name": "paxWeight",
      "type": "object",
      "required": true,
      "properties": {
        "businessClassKg": { "type": "number" },
        "economyClassKg": { "type": "number" },
        "premiumEconomyKg": { "type": "number" },
        "firstClassKg": { "type": "number" },
        "totalKg": { "type": "number" }
      }
    },
    {
      "name": "baggage",
      "type": "object",
      "required": true,
      "properties": {
        "totalPieces": { "type": "integer", "minimum": 0 },
        "totalWeightKg": { "type": "number", "minimum": 0 },
        "distribution": {
          "type": "object",
          "properties": {
            "forwardHold": { "type": "number", "minimum": 0 },
            "aftHold": { "type": "number", "minimum": 0 },
            "bulkHold": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "name": "cargo",
      "type": "object",
      "required": true,
      "properties": {
        "totalWeightKg": { "type": "number", "minimum": 0 },
        "distribution": {
          "type": "object",
          "properties": {
            "forwardHold": { "type": "number", "minimum": 0 },
            "aftHold": { "type": "number", "minimum": 0 },
            "bulkHold": { "type": "number", "minimum": 0 },
            "mainDeck": { "type": "number", "minimum": 0 }
          }
        },
        "specialLoads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "weightKg": { "type": "number" },
              "location": { "type": "string" },
              "dgClass": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "mail",
      "type": "object",
      "required": false,
      "properties": {
        "totalWeightKg": { "type": "number", "minimum": 0 },
        "distribution": {
          "type": "object",
          "properties": {
            "forwardHold": { "type": "number", "minimum": 0 },
            "aftHold": { "type": "number", "minimum": 0 },
            "bulkHold": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "name": "fuel",
      "type": "object",
      "required": true,
      "properties": {
        "tripFuelKg": { "type": "number" },
        "taxiFuelKg": { "type": "number" },
        "contingencyFuelKg": { "type": "number" },
        "alternateFuelKg": { "type": "number" },
        "finalReserveFuelKg": { "type": "number" },
        "extraFuelKg": { "type": "number" },
        "totalFuelKg": { "type": "number" },
        "fuelDensity": { "type": "number" }
      }
    },
    {
      "name": "calculatedWeights",
      "type": "object",
      "required": true,
      "properties": {
        "zeroFuelWeightKg": { "type": "number" },
        "zeroFuelIndex": { "type": "number" },
        "takeoffWeightKg": { "type": "number" },
        "takeoffIndex": { "type": "number" },
        "landingWeightKg": { "type": "number" },
        "landingIndex": { "type": "number" }
      }
    },
    {
      "name": "limits",
      "type": "object",
      "required": true,
      "properties": {
        "maxZeroFuelWeightKg": { "type": "number" },
        "maxTakeoffWeightKg": { "type": "number" },
        "maxLandingWeightKg": { "type": "number" },
        "maxZeroFuelIndex": { "type": "number" },
        "minZeroFuelIndex": { "type": "number" },
        "maxTakeoffIndex": { "type": "number" },
        "minTakeoffIndex": { "type": "number" }
      }
    },
    {
      "name": "underload",
      "type": "object",
      "required": true,
      "properties": {
        "zfwUnderloadKg": { "type": "number" },
        "towUnderloadKg": { "type": "number" },
        "lwUnderloadKg": { "type": "number" }
      }
    },
    {
      "name": "loadControlOfficer",
      "type": "string",
      "required": true
    },
    {
      "name": "preparedTime",
      "type": "string",
      "format": "date-time",
      "required": true
    },
    {
      "name": "version",
      "type": "integer",
      "required": true,
      "default": 1
    },
    {
      "name": "supersedes",
      "type": "string",
      "required": false
    }
  ],
  "workflow": [
    "DRAFT",
    "COMPUTED",
    "REVIEWED",
    "ISSUED",
    "SUPERSEDED",
    "ARCHIVED"
  ],
  "permissions": {
    "create": ["LOAD_CONTROLLER", "LOAD_CONTROL_SYSTEM"],
    "compute": ["LOAD_CONTROLLER", "LOAD_CONTROL_SYSTEM"],
    "review": ["SENIOR_LOAD_CONTROLLER", "LOAD_CONTROL_SUPERVISOR"],
    "issue": ["LOAD_CONTROLLER", "SENIOR_LOAD_CONTROLLER"],
    "supersede": ["LOAD_CONTROLLER", "SENIOR_LOAD_CONTROLLER"],
    "view": ["CREW", "DISPATCHER", "FLIGHT_OPS", "MANAGEMENT"]
  },
  "validationRules": [
    { "field": "calculatedWeights.zeroFuelWeightKg", "rule": "less_than_or_equal", "refField": "limits.maxZeroFuelWeightKg", "message": "ZFW exceeds maximum" },
    { "field": "calculatedWeights.takeoffWeightKg", "rule": "less_than_or_equal", "refField": "limits.maxTakeoffWeightKg", "message": "TOW exceeds maximum" },
    { "field": "calculatedWeights.landingWeightKg", "rule": "less_than_or_equal", "refField": "limits.maxLandingWeightKg", "message": "LW exceeds maximum" },
    { "field": "calculatedWeights.zeroFuelIndex", "rule": "between", "minRef": "limits.minZeroFuelIndex", "maxRef": "limits.maxZeroFuelIndex", "message": "ZFW index out of limits" }
  ],
  "uiMetadata": {
    "layout": "preliminary_loadsheet",
    "sections": [
      { "id": "header", "label": "Flight Identification", "fields": ["flightNumber", "airlineCode", "aircraftRegistration", "aircraftType", "departureAirport", "arrivalAirport", "operationalDate", "scheduledDeparture"] },
      { "id": "dow", "label": "Dry Operating Weight", "fields": ["dryOperatingWeight", "dryOperatingIndex"] },
      { "id": "pax", "label": "Passengers", "fields": ["paxDistribution", "paxWeight"] },
      { "id": "baggage", "label": "Baggage", "fields": ["baggage"] },
      { "id": "cargo", "label": "Cargo & Mail", "fields": ["cargo", "mail"] },
      { "id": "fuel", "label": "Fuel", "fields": ["fuel"] },
      { "id": "calculated", "label": "Calculated Weights & CG", "fields": ["calculatedWeights"] },
      { "id": "limits", "label": "Limits & Underload", "fields": ["limits", "underload"] },
      { "id": "authorization", "label": "Authorization", "fields": ["loadControlOfficer", "preparedTime", "version", "supersedes"] }
    ]
  },
  "pdfMetadata": {
    "template": "preliminary_loadsheet",
    "pageSize": "A4",
    "orientation": "landscape",
    "copies": 2,
    "distribution": ["Flight Crew", "Load Control"]
  },
  "auditRequired": true,
  "sourceReference": "IATA AHM 515, AHM 516, ICAO Annex 6, Operator W&B manual",
  "notes": "Preliminary loadsheet based on estimated weights. Final loadsheet required before departure. All weights in kg unless specified."
}